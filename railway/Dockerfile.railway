# syntax=docker/dockerfile:1
#
# Slim Railway image for the LLM-CLI agent box.
#
# Goal: a fast-cold-starting box that runs hermes-agent's gateway + the local
# OpenAI-compatible HTTP server, with the Claude Code CLI baked in so tasks can
# be delegated to it. Runs entirely on a Claude Pro/Max *subscription*
# (CLAUDE_CODE_OAUTH_TOKEN) — never a pay-per-token API key.
#
# Deliberately omits the heavy bits of the root Dockerfile (Playwright,
# WhatsApp bridge, ffmpeg) — they are not needed for the agent box and they
# dominate cold-start time.

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# System deps: python + node (>=18 for Claude Code) + git/ripgrep/curl.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git ripgrep \
        python3 python3-pip \
        nodejs npm && \
    rm -rf /var/lib/apt/lists/*

COPY . /opt/hermes
WORKDIR /opt/hermes

# Install hermes with a *minimal* extras set:
#   messaging -> aiohttp (required by the local OpenAI-compatible server) + the
#                Discord/Slack/Telegram gateways used for @tag personal agents
#   cron      -> scheduled overnight prep jobs
#   pty       -> Claude Code is an interactive terminal app (needs a PTY)
#   mcp       -> connect to the gbrain shared-brain MCP server
#   cli       -> setup/menu helpers
# ...plus the Claude Code CLI itself (the v1 coding spine).
RUN pip install --no-cache-dir -e ".[messaging,cron,pty,mcp,cli]" --break-system-packages && \
    pip install --no-cache-dir --break-system-packages "cryptography>=43" "psycopg[binary]>=3.1" && \
    npm install -g @anthropic-ai/claude-code && \
    npm cache clean --force

RUN chmod +x /opt/hermes/railway/entrypoint.sh && \
    chmod +x /opt/hermes/railway/bin/claude-as-user && \
    ln -sf /opt/hermes/railway/bin/claude-as-user /usr/local/bin/claude-as-user

# Persistent volume target — mount a Railway volume here so sessions, skills,
# memories, per-user credentials and config survive redeploys.
ENV HERMES_HOME=/opt/data
# VOLUME [ "/opt/data" ]

ENTRYPOINT [ "/opt/hermes/railway/entrypoint.sh" ]
