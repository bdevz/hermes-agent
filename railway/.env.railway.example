# =============================================================================
# Railway agent-box environment (subscription-only, no model-billing API)
# =============================================================================
# Copy the values you need into your Railway service variables. This file
# documents every variable the agent box understands. See railway/README.md.
#
# GUARDRAIL: do NOT set ANTHROPIC_API_KEY or OPENAI_API_KEY. The entrypoint
# refuses to start if either is present — this box runs on Claude subscriptions
# only, and a billing key would silently route Claude Code to the paid API.

# ----- Local OpenAI-compatible HTTP server (the web front door's backend) -----
# Enabled + bound to 0.0.0.0:$PORT automatically by the entrypoint; override
# only if you know why.
API_SERVER_ENABLED=true
# Shared secret the Open WebUI service presents as its "OpenAI API key". This is
# a LOCAL auth token for our own server — NOT a model-billing key. Generate a
# random value (e.g. `openssl rand -hex 32`).
API_SERVER_KEY=replace-with-a-long-random-string
# API_SERVER_HOST=0.0.0.0          # set by entrypoint
# API_SERVER_PORT=8642             # set by entrypoint from $PORT

# ----- Claude subscription auth (NO API billing) -----
# Operator/default agent token. Generate on a machine with a browser:
#   claude setup-token         (requires Claude Pro/Max/Team/Enterprise)
# Per-user tokens (Epic C) are supplied at runtime and stored per account, not
# here.
CLAUDE_CODE_OAUTH_TOKEN=

# ----- Persistent storage -----
# Mount a Railway volume at this path so sessions/skills/memories/credentials
# survive redeploys.
HERMES_HOME=/opt/data

# ----- Shared database / team brain (Epic D, day-one) -----
# Connection string to the Railway pgvector Postgres service. Used for the
# per-user credential store, usage tracking, and the gbrain shared brain.
# Railway exposes this automatically when you reference the Postgres plugin,
# e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Encryption key for the per-user credential store (Epic C). 32-byte urlsafe
# base64 key, e.g. `python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`
USER_CRED_ENC_KEY=

# ----- Optional: chat gateways for @tag personal agents (Epic C3) -----
# Fill in only the platform(s) you use; leave the rest blank.
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
